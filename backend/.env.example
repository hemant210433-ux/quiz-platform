# ---- Server ----
NODE_ENV=production
PORT=4000

# ---- Database (MongoDB Atlas) ----
# Paste the connection string from Atlas -> Connect -> Drivers. Use a password WITHOUT special characters.
# If MONGODB_URI is empty the app falls back to local JSON files in DATA_DIR (local development only).
MONGODB_URI=mongodb+srv://hk210433_db_user:T70tRQqDR2QTlPr1@cluster0.8rmvauc.mongodb.net/
MONGODB_DB=quizplatform

# Only used when MONGODB_URI is empty (local development):
# DATA_DIR=./data

# ---- Frontend hosting ----
# Frontend on Vercel (recommended: Vercel proxies /api to this server, so no CORS is needed):
SERVE_FRONTEND=false
# Only needed if you do NOT use the Vercel proxy and call this API directly from another domain:
# CORS_ORIGIN=https://your-app.vercel.app
# COOKIE_SAMESITE=none      # (cross-site cookies are blocked by Safari/Brave – the proxy setup is more reliable)

# Number of reverse proxies in front of Node (Render = 1).
TRUST_PROXY=1

# ---- Admin bootstrap (used ONLY when no admin exists yet) ----
# On Render you have no shell, so set these once, deploy, log in, then you may delete them.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-your-own-10+chars-with-letters-and-numbers

# ---- Sessions / cookies ----
SESSION_TTL_HOURS=12
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ---- Rate limits (all students reach the API through Vercel's proxy, so keep these high) ----
LOGIN_RATE_WINDOW_MIN=15
LOGIN_RATE_MAX=10
PUBLIC_RATE_MAX_PER_MIN=30000
START_RATE_MAX_PER_10MIN=5000

# ---- Quiz timing ----
SUBMIT_GRACE_SECONDS=30

# ---- Backups ----
MAX_BACKUPS=20
