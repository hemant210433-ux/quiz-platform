{
  "name": "quiz-platform-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup-admin": "node src/scripts/setupAdmin.js",
    "backup": "node src/scripts/backup.js",
    "restore": "node src/scripts/restore.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "migrate-to-mongo": "node src/scripts/migrateToMongo.js",
    "test:mongo": "node --test --test-concurrency=1 test/mongo.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "mongodb": "^6.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
