# Server-side only. The Express backend (Render). No trailing slash, no /api.
# Required for production builds (the build fails with a clear message if missing).
BACKEND_URL=https://your-service.onrender.com

# Public URL of THIS site (used for sitemap, robots, canonical links)
NEXT_PUBLIC_SITE_URL=https://olevelmocktest.in

# Optional: shown on the Contact page
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Optional (Plan B only): call the API directly instead of the Next.js proxy
# NEXT_PUBLIC_API_BASE_URL=
