# Leave EMPTY for the recommended setup (Vercel rewrites /api/* to your Render backend,
# see frontend/vercel.json). Only fill this if you want the browser to call the API directly,
# e.g. https://your-service.onrender.com  (then also set CORS_ORIGIN + COOKIE_SAMESITE=none on the backend).
VITE_API_BASE_URL=
